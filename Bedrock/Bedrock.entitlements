<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Family Controls — request a separate entitlement per bundle ID (§3, §9).
	     Distribution tier is the weeks-long Apple approval on the critical path. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.thebedrock.app</string>
	</array>
	<!-- Sign in with Apple (auth after the paywall). Enable the capability on the
	     App ID too; automatic signing provisions it for development. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push: a supporter's approval requests and check-in alerts (SP3). Xcode
	     signs App Store builds with "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: thebedrock.app/join/CODE opens SP1 (needs the
	     apple-app-site-association file on the site, website/.well-known/). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:thebedrock.app</string>
	</array>
</dict>
</plist>
