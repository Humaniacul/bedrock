    "onb.s10.limits_sheet": {
      "comment": "S10 · What 2am you will face · Limits sheet. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Strict Mode can’t stop · Erasing this iPhone. That removes everything, Bedrock included. · Anyone who knows your Screen Time passcode. · Other phones, tablets and computers. · Versions of iOS where the lock isn’t reliable. Bedrock tells you if yours is one. · Better you hear it now than at 2am. · Got it"
          }
        }
      }
    },
    "onb.s10.link": {
      "comment": "S10 · What 2am you will face · Link.",
