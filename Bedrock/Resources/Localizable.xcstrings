    "onb.b2.body": {
      "comment": "B2 · Screen Time is managed · Body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A parent, school or company controls Screen Time here, so Bedrock can’t put up a wall. Your urge button and your foundation still work."
          }
        }
      }
    },
