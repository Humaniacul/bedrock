<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Bedrock</string>
	<key>CFBundleName</key>
	<string>Bedrock</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Obsidian from the first frame: no white flash before S1. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- S13.4B: the floating digit window over Settings is Picture in Picture,
	     which needs the "Audio, AirPlay, and Picture in Picture" mode. No audio plays. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- bedrock://join/CODE, the fallback for thebedrock.app/join/CODE (SP1). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.thebedrock.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bedrock</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Instrument Serif (SIL OFL 1.1, Resources/Fonts/OFL.txt). Onboarding serif;
	     BedrockFont falls back to New York if these fail to load. -->
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- §9 two-register rule: Apple-facing copy uses focus / usage-management
	     framing ONLY. No recovery / addiction language in any system string. -->
	<key>NSFamilyControlsUsageDescription</key>
	<string>Bedrock uses Screen Time to help you limit the distracting apps and websites you choose, so you can stay focused.</string>
	<!-- Bedrock API base URL (Phase 3). Empty = stub mode (no backend). Set to
	     your Railway deployment URL to turn on accountability features. -->
	<key>BEDROCK_API_BASE_URL</key>
	<string>https://bedrock-production-3d8f.up.railway.app</string>
	<!-- RevenueCat PUBLIC SDK key (§3, §8). This is the publishable client key
	     (starts with "appl_") — safe to ship in the app, unlike the secret/webhook
	     keys. Empty = the paywall runs in local/fallback mode (no real purchases).
	     Get it from RevenueCat → Project → API keys → Apple App Store. -->
	<key>REVENUECAT_API_KEY</key>
	<string>appl_kwXBLpuSYnbSZTIqBrpYxQsCepK</string>
	<!-- S4's test page. Its domain goes behind the web filter on S3, and its
	     <title> carries "Bedrock wall test" so the background check can tell it
	     opened (website/test/index.html). -->
	<key>BEDROCK_WALL_TEST_URL</key>
	<string>https://test.thebedrock.app</string>
	<!-- PostHog project key (EU). Empty = analytics off; nothing leaves the phone.
	     The project key is public by design (like the RevenueCat SDK key). -->
	<key>POSTHOG_API_KEY</key>
	<string></string>
	<!-- Allow http to localhost for local backend development. Production uses
	     https (Railway), so this affects only on-device/simulator dev. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
