    "onb.s10.step_1": {
      "comment": "S10 · What 2am you will face · Step 1. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the letter you write today · You write it during setup. It stays on screen before you can go on."
          }
        }
      }
    },
    "onb.s10.step_2": {
      "comment": "S10 · What 2am you will face · Step 2. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe, then rate the urge · A slow breath first. Urges tend to rise, peak and pass."
          }
        }
      }
    },
    "onb.s10.step_3": {
      "comment": "S10 · What 2am you will face · Step 3. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your commitment, word for word · Pasting is blocked. One typo starts it over."
          }
        }
      }
    },
    "onb.s10.step_4": {
      "comment": "S10 · What 2am you will face · Step 4. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your person hears about it · If someone holds your key, they’re told you’re asking."
          }
        }
      }
    },
    "onb.s10.step_5": {
      "comment": "S10 · What 2am you will face · Step 5. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait thirty minutes · Leave the app and the clock restarts."
          }
        }
      }
    },
    "onb.s10.step_6": {
      "comment": "S10 · What 2am you will face · Step 6. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only then does it open · Your person approves, or Bedrock releases the code. Try again the same night and it takes longer."
          }
        }
      }
    },
    "onb.s11.body": {
