    "onb.s11.option_b": {
      "comment": "S11 · Who holds the key · Option B. Contains “ · ”: usually separate strings (title · subtitle, sheet rows). Split into their own keys when building the view, unless the UI shows a literal middle dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
